# Find these values in Supabase: Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Canonical deployed app origin used for Auth email redirects. Keep localhost for local development.
# When unset, Big Al uses the current forwarded request origin (including Codespaces previews).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
